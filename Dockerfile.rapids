# syntax=docker/dockerfile:1.7

ARG CONDA_ENV_NAME=molevo-rapids-dask-draft

FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

ARG CONDA_ENV_NAME=molevo-rapids-dask-draft

ENV CONDA_ENV_NAME=${CONDA_ENV_NAME} \
    CUDA_HOME=/opt/conda/envs/${CONDA_ENV_NAME} \
    PATH=/opt/conda/bin:/opt/conda/envs/${CONDA_ENV_NAME}/bin:/usr/local/bin:$PATH \
    LD_LIBRARY_PATH=/opt/conda/envs/${CONDA_ENV_NAME}/lib:$LD_LIBRARY_PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apk add --no-cache \
    conda \
    conda-init \
    conda-wrapper \
    bash \
    ca-certificates-bundle \
    libstdc++ \
    libgcc \
    libgomp \
    git \
    curl

# Normalize conda location so PATH is stable across Wolfi package layout changes.
RUN CONDA_BASE="$(conda info --base)" \
    && if [ "$CONDA_BASE" != "/opt/conda" ]; then ln -s "$CONDA_BASE" /opt/conda; fi

RUN conda init --system bash

SHELL ["/bin/bash", "-lc"]

COPY environment.yml /tmp/environment.yml

# Build project environment from the repository spec.
RUN source /etc/profile.d/conda.sh \
    && conda env create -p /opt/conda/envs/${CONDA_ENV_NAME} -f /tmp/environment.yml \
    && chown -R nonroot:nonroot /opt/conda \
    && rm -f /tmp/environment.yml \
    && rm -rf /opt/conda/pkgs/* /tmp/conda* /root/.cache/pip 2>/dev/null || true

#RUN conda run -p /opt/conda/envs/${CONDA_ENV_NAME} python -c "import rdkit; import dask; import cudf; import cuml; print('wolfi-conda-rapids-smoke-ok')"

USER nonroot
WORKDIR /workspace

CMD ["bash", "-lc", "source /etc/profile.d/conda.sh && conda activate /opt/conda/envs/${CONDA_ENV_NAME} && exec bash"]
