# syntax=docker/dockerfile:1.7

ARG MINIFORGE_VERSION=24.11.0-0
ARG QUICKVINA_REPO=https://github.com/DeltaGroupNJUPT/Vina-GPU-2.1.git
ARG QUICKVINA_REF=main
ARG CONDA_ENV_NAME=saturn-runtime

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS quickvina-builder

ARG QUICKVINA_REPO
ARG QUICKVINA_REF

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    make \
    g++ \
    libboost-all-dev \
    ocl-icd-opencl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src

RUN git clone --depth 1 --branch ${QUICKVINA_REF} ${QUICKVINA_REPO} quickvina-src

# QuickVina2-GPU expects to run from its own directory to resolve OpenCL assets.
RUN cd /opt/src/quickvina-src/QuickVina2-GPU-2.1 \
    && sed -i 's|^WORK_DIR=.*|WORK_DIR=$(shell pwd)|' Makefile \
    && sed -i 's|^BOOST_LIB_PATH=.*|BOOST_LIB_PATH=/usr|' Makefile \
    && sed -i 's|^OPENCL_LIB_PATH=.*|OPENCL_LIB_PATH=/usr|' Makefile \
    && sed -i 's|^LIB1=.*|LIB1=-lboost_program_options -lboost_system -lboost_filesystem -lboost_thread -lOpenCL|' Makefile \
    && sed -i 's|^LIB_PATH=.*|LIB_PATH=-L/usr/lib/x86_64-linux-gnu|' Makefile \
    && sed -i 's|^SRC=.*|SRC=./lib/*.cpp ./OpenCL/src/wrapcl.cpp|' Makefile \
    && make -j"$(nproc)" \
    && test -x QuickVina2-GPU-2-1

FROM cgr.dev/chainguard/wolfi-base:latest AS runtime

ARG MINIFORGE_VERSION=24.11.0-0
ARG SATURN_REPRO_DIR=/opt/saturn_core/experimental_reproduction/synthesizability
ARG CONDA_ENV_NAME=saturn-runtime

ENV CONDA_DIR=/opt/conda \
    CONDA_ENV_NAME=${CONDA_ENV_NAME} \
    CUDA_HOME=/opt/conda/envs/${CONDA_ENV_NAME} \
    PATH=/opt/conda/envs/${CONDA_ENV_NAME}/bin:/opt/conda/bin:$PATH \
    LD_LIBRARY_PATH=/opt/conda/envs/${CONDA_ENV_NAME}/lib:${LD_LIBRARY_PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN set -eux; \
    for i in 1 2 3 4 5; do \
        apk add --no-cache \
            conda \
            conda-init \
            conda-wrapper \
            bash \
            ca-certificates-bundle \
            libstdc++ \
            libgcc \
            libgomp \
            curl \
            git \
            gcc \
            make \
        && break; \
        if [ "$i" -eq 5 ]; then exit 1; fi; \
        echo "apk add attempt $i failed, retrying..."; \
    done

# Normalize conda location so PATH is stable across Wolfi package layout changes.
RUN CONDA_BASE="$(conda info --base)" \
    && if [ "$CONDA_BASE" != "/opt/conda" ]; then ln -s "$CONDA_BASE" /opt/conda; fi

SHELL ["/bin/bash", "-lc"]

RUN conda create -y -p /opt/conda/envs/${CONDA_ENV_NAME} -c conda-forge \
        python=3.10 \
    "numpy<2" \
        pandas \
        scipy \
        joblib \
        tqdm \
        rdkit \
        openbabel \
        pip \
    && /opt/conda/envs/${CONDA_ENV_NAME}/bin/pip install --no-cache-dir \
        selfies \
        guacamol \
        morfeus-ml \
        molscore \
        cupy-cuda12x \
        "numpy<2" \
    && (rm -rf /opt/conda/pkgs/* /tmp/conda* /root/.cache/pip 2>/dev/null || true)

RUN mkdir -p /vina ${SATURN_REPRO_DIR}

COPY --from=quickvina-builder /opt/src/quickvina-src/QuickVina2-GPU-2.1 /vina/QuickVina2-GPU-2.1

RUN test -x /vina/QuickVina2-GPU-2.1/QuickVina2-GPU-2-1 \
    && ln -sfn /vina/QuickVina2-GPU-2.1 ${SATURN_REPRO_DIR}/QuickVina2-GPU-2.1

RUN /opt/conda/envs/${CONDA_ENV_NAME}/bin/python -c "import numpy as np; assert int(np.__version__.split('.')[0]) < 2, np.__version__; import rdkit; import openbabel; import selfies; import guacamol; import molscore; import cupy; print('saturn-image-smoke-ok')"

# Neutralize upstream entrypoint so helper scripts can run arbitrary commands.
ENTRYPOINT []

WORKDIR /workspace

CMD ["bash", "-lc", "exec bash"]