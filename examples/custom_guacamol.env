# Example custom GuacaMol/MolScore run settings.
# Source this through run_custom_spectralmol_ibex.sh:
#   CONFIG_FILE=examples/custom_guacamol.env bash run_custom_spectralmol_ibex.sh
#   CONFIG_FILE=examples/custom_guacamol.env SUBMIT=1 bash run_custom_spectralmol_ibex.sh

BENCHMARK_KIND=guacamol
SUBMIT=0

# Use the standard MolScore preset, or point CUSTOM_BENCHMARK to a directory of
# custom task JSON files.
BENCHMARK=GuacaMol
CUSTOM_BENCHMARK=

# Run SpectralMol only by default. Set MODELS=spectralmol,graphga for a GraphGA
# comparison and set EXAMPLES_ROOT to a MolScore_examples checkout.
MODELS=spectralmol
EXAMPLES_ROOT=/home/$USER/molevoDrugDiscovery_2/MolScore_examples

# Select tasks. TASK_INDEXES_CSV uses MolScore task indexes after filtering.
# Leave both empty to run all tasks in the selected benchmark.
TASK_INDEXES_CSV=
INCLUDE_CSV=
EXCLUDE_CSV=

# Initial molecules and budget.
SEED_SMILES_FILE=/ibex/scratch/$USER/spectralMol/guacamol_graphga_vs_spectralmol/compare_GuacaMol_20260710_155012/shared_initial_population/seed_7.smi
SEEDS=7
SEED_POOL_SIZE=256
BUDGET=10000
GENERATIONS=50
POPULATION_SIZE=256
BATCH_SIZE=64

# Output path. The wrapper creates a timestamped default if this is empty.
OUTPUT_DIR=

# Spectral theta settings.
FREQUENCY_MODE=full-spectrum
SPECTRAL_L=32
SPECTRAL_K=16
SPECTRAL_D=32
SPECTRAL_DECODE_ATTEMPTS=8
SPECTRAL_TASK_PROFILE_MODE=manual
SPECTRAL_TASK_PROFILE=manual

# Keep benchmark reproduction theta-only.
SPECTRAL_PHENOTYPE_PROPOSAL_FRACTION=0
SPECTRAL_BRICS_CROSSOVER_FRACTION=0
SPECTRAL_BRICS_FRAGMENT_REPLACE_FRACTION=0

# Slurm request.
CPUS_PER_TASK=32
MEM=96G
TIME=72:00:00
PARTITION=

# Set to 1 only for the standard 20-task GuacaMol array mapping.
GUACAMOL_USE_TASK_ARRAY=0
TASK_ARRAY=0-19%20

