# Example custom SATURN theta NSGA-II run settings.
# Source this through run_custom_spectralmol.sh:
#   CONFIG_FILE=examples/custom_saturn.env bash run_custom_spectralmol.sh
#   CONFIG_FILE=examples/custom_saturn.env SUBMIT=1 bash run_custom_spectralmol.sh

BENCHMARK_KIND=saturn
EXECUTION_BACKEND=local
SUBMIT=0

# Seeds. TASK_ARRAY indexes into SEED_LIST, so TASK_ARRAY=0 runs the first seed.
SEED_LIST=0
TASK_ARRAY=0
BUDGET=1000
POPULATION_SIZE=256
BATCH_SIZE=16
GENERATIONS=0

# Use one shared seed file for a custom case.
USE_PER_SEED_SEED_SMILES=0
SEED_SMILES_FILE=$PWD/reproducibility/manuscript_2026/inputs/saturn/seed_sets/seed_0.smi
PER_SEED_SEED_SMILES_DIR=
SEED_POOL_SIZE=256

# SATURN/QuickVina assets. Replace these for a different target.
SATURN_REPO_ROOT=$PWD/../saturn
SATURN_ORACLE_TEMPLATE=$PWD/spectralMol/benchmarks/Saturn/table2_r_sa_qed_oracle_template.json
SATURN_ORACLE_CONFIG_KEY=oracle
ASSETS_ROOT=$PWD/reproducibility/manuscript_2026/inputs/saturn/docking
QUICKVINA_BINARY=/path/to/QuickVina2-GPU-2-1
RECEPTOR_FILE=$ASSETS_ROOT/7uvu-2-monomers-pdbfixer.pdbqt
REFERENCE_LIGAND_FILE=$ASSETS_ROOT/7uvu-reference.pdb
MOLSCORE_SATURN_OBABEL_BINARY=obabel

# Output path. The wrapper creates a timestamped default if this is empty.
OUTPUT_ROOT=

# Spectral theta settings.
FREQUENCY_MODE=full-spectrum
SPECTRAL_L=48
SPECTRAL_K=24
SPECTRAL_D=32
SPECTRAL_DECODE_ATTEMPTS=16

# Optional GPU/OpenCL settings. Leave empty when the system loader discovers them.
SATURN_MODULES=
OCL_ICD_VENDORS=
MOLSCORE_SATURN_OPENCL_LIB_DIR=
MOLSCORE_SATURN_OPENCL_PRELOAD=0

# Slurm request.
CPUS_PER_TASK=1
MEM=32G
TIME=24:00:00
GRES=gpu:1
PARTITION=

