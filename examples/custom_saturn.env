# Example custom SATURN theta NSGA-II run settings.
# Source this through run_custom_spectralmol_ibex.sh:
#   CONFIG_FILE=examples/custom_saturn.env bash run_custom_spectralmol_ibex.sh
#   CONFIG_FILE=examples/custom_saturn.env SUBMIT=1 bash run_custom_spectralmol_ibex.sh

BENCHMARK_KIND=saturn
SUBMIT=0

# Seeds. TASK_ARRAY indexes into SEED_LIST, so TASK_ARRAY=0 runs the first seed.
SEED_LIST=0
TASK_ARRAY=0
BUDGET=1000
POPULATION_SIZE=256
BATCH_SIZE=16
GENERATIONS=0

# Use one shared seed file for a custom case.
USE_PER_SEED_SEED_SMILES=0
SEED_SMILES_FILE=/path/to/custom_seed_population.smi
PER_SEED_SEED_SMILES_DIR=
SEED_POOL_SIZE=256

# SATURN/QuickVina assets. Replace these for a different target.
SATURN_REPO_ROOT=/home/$USER/molevoDrugDiscovery_2/Saturn/saturn_repo2
SATURN_ORACLE_TEMPLATE=/home/$USER/molevoDrugDiscovery_2/Saturn/local_evolution/table2_r_sa_qed_oracle_template.json
SATURN_ORACLE_CONFIG_KEY=oracle
ASSETS_ROOT=/home/$USER/molevoDrugDiscovery_2/Saturn/saturn_repo_clean/experimental_reproduction/synthesizability
QUICKVINA_BINARY=/home/$USER/molevoDrugDiscovery_2/Saturn/saturn_repo2/experimental_reproduction/synthesizability/QuickVina2-GPU-2.1/QuickVina2-GPU-2-1
RECEPTOR_FILE=/home/$USER/molevoDrugDiscovery_2/Saturn/saturn_repo_clean/experimental_reproduction/synthesizability/7uvu-2-monomers-pdbfixer.pdbqt
REFERENCE_LIGAND_FILE=/home/$USER/molevoDrugDiscovery_2/Saturn/saturn_repo_clean/experimental_reproduction/synthesizability/7uvu-reference.pdb
MOLSCORE_SATURN_OBABEL_BINARY=/ibex/user/$USER/conda-environments/openbabel-cli/bin/obabel

# Output path. The wrapper creates a timestamped default if this is empty.
OUTPUT_ROOT=

# Spectral theta settings.
FREQUENCY_MODE=full-spectrum
SPECTRAL_L=48
SPECTRAL_K=24
SPECTRAL_D=32
SPECTRAL_DECODE_ATTEMPTS=16

# IBEX GPU/OpenCL settings used by the final SATURN reproduction.
SATURN_MODULES=cuda/11.8
OCL_ICD_VENDORS=/etc/OpenCL/vendors/nvidia.icd
MOLSCORE_SATURN_OPENCL_LIB_DIR=/lib64
MOLSCORE_SATURN_OPENCL_PRELOAD=1

# Slurm request.
CPUS_PER_TASK=1
MEM=32G
TIME=24:00:00
GRES=gpu:1
PARTITION=

